{
  "schema_version": "0.2",
  "id": "wf_churn_drivers",
  "name": "Churn drivers analysis",
  "objective": "Identify churn drivers and produce a validated executive report.",
  "nodes": [
    {
      "id": "frame",
      "role": "business_framer",
      "depends_on": [],
      "harness": {
        "provider": "chatgpt_host",
        "model": "current-chatgpt-model",
        "tools": ["artifact.read"],
        "approval": "never",
        "max_retries": 0,
        "timeout_seconds": 300,
        "network": "deny"
      }
