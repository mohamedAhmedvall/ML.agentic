        "network": "deny"
      }
    },
    {
      "id": "review",
      "role": "model_reviewer",
      "depends_on": ["build"],
      "harness": {
        "provider": "ollama",
        "model": "qwen3",
        "tools": ["artifact.read", "evidence.check"],
